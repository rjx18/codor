{
  "name": "@codor/adapter-copilot",
  "version": "0.10.14-alpha.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "vscode:build": "tsc -p vscode-extension/tsconfig.json",
    "vscode:package": "pnpm vscode:build && cd vscode-extension && vsce package --no-dependencies"
  },
  "dependencies": {
    "@codor/protocol": "workspace:*",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.6.2"
  }
}
