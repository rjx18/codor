{
  "name": "codor-copilot-bridge",
  "displayName": "Codor Copilot Bridge",
  "description": "Connect Codor to the native GitHub Copilot agent already authenticated in VS Code.",
  "version": "0.10.12",
  "publisher": "codor",
  "license": "MIT",
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codor.copilotBridge.status"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codor.copilotBridge.status",
        "title": "Codor: Show Copilot Bridge Status"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies"
  }
}
